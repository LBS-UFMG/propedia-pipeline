configfile: "config/config.yaml"

MODE  = config["mode"]

# ---- alt-threshold datasets (cutoff sensitivity / reviewer alternatives) ----
# A non-empty `variant` builds an ALTERNATIVE dataset alongside the canonical one:
# outputs and durable state get a `__<variant>` suffix so the default build is never
# overwritten. If `variant` names an entry in `cutoff_variants`, those cutoff overrides
# are applied automatically — one knob:  `snakemake --cores N --config mode=full variant=dist8`
# (define new thresholds as a `cutoff_variants` profile; see docs/reproduction_notes.md).
VARIANT = str(config.get("variant", "") or "").strip()
if VARIANT:
    overrides = (config.get("cutoff_variants") or {}).get(VARIANT)
    if overrides:
        config["cutoffs"] = {**config["cutoffs"], **overrides}
        # keep PRODIGY's contact distance aligned with the selection distance
        if "interaction_distance_A" in overrides:
            config["prodigy"]["distance_cutoff"] = overrides["interaction_distance_A"]
_SUFFIX = f"__{VARIANT}" if VARIANT else ""

OUT   = f"{config['paths']['results_dir']}/{MODE}{_SUFFIX}"   # DERIVED outputs (disposable)
STATE = f"{config['paths']['state_dir']}/{MODE}{_SUFFIX}"     # DURABLE state: checkpoints + structures

include: "rules/01_collect.smk"
include: "rules/02_download.smk"
include: "rules/03_extract.smk"
include: "rules/04_features.smk"
include: "rules/05_cluster.smk"
include: "rules/06_ml.smk"
include: "rules/07_validate.smk"
include: "rules/08_assemble.smk"
include: "rules/09_multipro.smk"
include: "rules/10_release.smk"
include: "rules/11_package.smk"

rule all:
    input:
        f"{OUT}/propedia.csv",
        f"{OUT}/multipro_final.csv",
        f"{OUT}/reproduction_report.txt"


# One-command production build: the validated dataset PLUS everything the website needs
# — the packaged per-entry web tree (data/db/…, incl. the multipro-contacts branch that
# `package` pulls in) and the bulk-download zips. The result under <web_dir> is ready to
# rsync to the server, so deployment is a pure transfer.
#   snakemake --cores N site --config mode=full
# Kept OUT of `rule all` on purpose: quick/sample runs shouldn't build the multi-GB zips.
rule site:
    input:
        f"{OUT}/reproduction_report.txt",
        f"{WEB}/.packaged",
        f"{WEB}/data/.zipped",